<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="API\Filters\**" />
    <Compile Remove="API\Middlewares\**" />
    <Compile Remove="Application\Exceptions\**" />
    <Compile Remove="Infrastructure\Email\**" />
    <Compile Remove="Infrastructure\Repositories\**" />
    <Content Remove="API\Filters\**" />
    <Content Remove="API\Middlewares\**" />
    <Content Remove="Application\Exceptions\**" />
    <Content Remove="Infrastructure\Email\**" />
    <Content Remove="Infrastructure\Repositories\**" />
    <Content Include="..\.dockerignore">
      <Link>.dockerignore</Link>
    </Content>
    <EmbeddedResource Remove="API\Filters\**" />
    <EmbeddedResource Remove="API\Middlewares\**" />
    <EmbeddedResource Remove="Application\Exceptions\**" />
    <EmbeddedResource Remove="Infrastructure\Email\**" />
    <EmbeddedResource Remove="Infrastructure\Repositories\**" />
    <None Remove="API\Filters\**" />
    <None Remove="API\Middlewares\**" />
    <None Remove="Application\Exceptions\**" />
    <None Remove="Infrastructure\Email\**" />
    <None Remove="Infrastructure\Repositories\**" />
