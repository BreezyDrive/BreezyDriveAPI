{
  "DatabaseSettings": {
    "DatabaseName": "ConversationDB"
  },

  "FileStorage": {
    "BaseUrl": "http://localhost:5000/api/ConversationMessage/DownloadFile/",
    "FileSizeLimits": {
      "MaxFileSizeInMB": 10,
      "MaxTotalFileSizeInMB": 50
    },
    "AllowedFileTypes": {
      "Images": [
        "image/jpeg",
        "image/png",
        "image/gif"
      ],
      "Documents": [
        "application/pdf",
        "application/msword",
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
      ]
    }
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*"
}
